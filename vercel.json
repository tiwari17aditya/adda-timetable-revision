{
  "version": 2,
  "functions": {
    "api/neon.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)\.css", "dest": "/$1.css" },
    { "src": "/(.*)\.js", "dest": "/$1.js" },
    { "src": "/(.*)\.json", "dest": "/$1.json" },
    { "src": "/(.*)\.pdf", "dest": "/$1.pdf" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
